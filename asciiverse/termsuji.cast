[1.976, "o", "\u001b[?25l\u001b[2;3H\u001b(B\u001b[m\u001b[33;40m\u001b]8;;\u001b\\A new game against GNU Go\u001b[3;38H\u001b(B\u001b[m\u001b[40m\u001b]8;;\u001b\\                            \u001b[5;4H\u001b(B\u001b[m\u001b[93;40m\u001b]8;;\u001b\\Board\u001b(B\u001b[m\u001b[40m\u001b]8;;\u001b\\       \u001b[5;30H\u001b(B\u001b[m\u001b[94;107m\u001b]8;;\u001b\\9x9\u001b(B\u001b[m\u001b[107m\u001b]8;;\u001b\\  \u001b[6;8H\u001b(B\u001b[m\u001b[40m\u001b]8;;\u001b\\                                    \u001b[7;4H\u001b(B\u001b[m\u001b[93;40m\u001b]8;;\u001b\\You play\u001b(B\u001b[m\u001b[40m\u001b]8;;\u001b\\  \u001b[7;30H\u001b(B\u001b[m\u001b[97;104m\u001b]8;;\u001b\\Black (first)\u001b[8;8H\u001b(B\u001b[m\u001b[40m\u001b]8;;\u001b\\                   \u001b[9;4H\u001b(B\u001b[m\u001b[93;40m\u001b]8;;\u001b\\GNU Go's strength\u001b[9;30H\u001b(B\u001b[m\u001b[97;104m\u001b]8;;\u001b\\5\u001b(B\u001b[m\u001b[104m\u001b]8;;\u001b\\             \u001b[11;4H\u001b(B\u001b[m\u001b[93;40m\u001b]8;;\u001b\\Handicap stones for Black\u001b[11;30H\u001b(B\u001b[m\u001b[97;104m\u001b]8;;\u001b\\none\u001b[13;4H\u001b(B\u001b[m\u001b[104m\u001b]8;;\u001b\\  \u001b(B\u001b[m\u001b[97;104m\u001b]8;;\u001b\\Play\u001b(B\u001b[m\u001b[104m\u001b]8;;\u001b\\  \u001b[13;13H  \u001b(B\u001b[m\u001b[97;104m\u001b]8;;\u001b\\Back\u001b(B\u001b[m\u001b[104m\u001b]8;;\u001b\\  \u001b[29;3H\u001b(B\u001b[m\u001b[40m\u001b]8;;\u001b\\Up/Down\u001b[29;11Hor\u001b[29;14HTab:\u001b[29;19Hchoose,\u001b[29;27HReturn:\u001b[29;35Hopen\u001b[29;40Ha\u001b[29;42Hlist,\u001b[29;48HEsc:\u001b[29;53Hback\u001b[?25l"]
